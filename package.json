{
  "name": "prov-capi-ui-extensions",
  "version": "0.0.1",
  "private": false,
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@rancher/shell": "v3.0.15-rc.4",
    "ipaddr.js": "2.5.0"
  },
  "devDependencies": {
    "@rancher/cypress":                       "1.0.7",
    "@types/jest":                            "29.5.12",
    "@types/lodash":                          "4.17.25",
    "@vue/test-utils":                        "2.4.6",
    "@vue/vue3-jest":                         "29.2.6",
    "babel-jest":                             "29.7.0",
    "babel-plugin-transform-require-context": "0.1.1",
    "cypress":                                "15.19.0",
    "eslint-plugin-node":                     "11.1.0",
    "eslint-plugin-promise":                  "7.3.0",
    "jest":                                   "29.7.0",
    "jest-environment-jsdom":                 "29.7.0",
    "ts-jest":                                "29.4.12"
  },
  "resolutions": {
    "@types/node": "26.2.0",
    "@types/lodash": "4.17.25"
  },
  "scripts": {
    "dev": "NODE_ENV=dev ./node_modules/.bin/vue-cli-service serve",
    "build": "./node_modules/.bin/vue-cli-service build",
    "clean": "./node_modules/@rancher/shell/scripts/clean",
    "build-pkg": "./node_modules/@rancher/shell/scripts/build-pkg.sh",
    "serve-pkgs": "./node_modules/@rancher/shell/scripts/serve-pkgs",
    "publish-pkgs": "./node_modules/@rancher/shell/scripts/extension/publish",
    "parse-tag-name": "./node_modules/@rancher/shell/scripts/extension/parse-tag-name",
    "lint": "./node_modules/.bin/eslint pkg/${PKG:-capa} cypress",
    "test": "jest",
    "test:ci": "NODE_OPTIONS=--max_old_space_size=8192 jest --silent",
    "cy:open": "./node_modules/.bin/cypress open --config numTestsKeptInMemory=10",
    "cy:run": "./node_modules/.bin/cypress run",
    "e2e:ci": "./node_modules/.bin/cypress run --browser chrome"
  }
}